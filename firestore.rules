rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return isSignedIn() ? getUserData().role : '';
    }

    function isAdmin() {
      return isSignedIn() && getUserRole() == 'admin';
    }

    function isPrintingDept() {
      return isSignedIn() && getUserRole() == 'printing';
    }

    function isOperations() {
      return isSignedIn() && (getUserRole() in ['admin', 'operations']);
    }

    function isStaff() {
      return isSignedIn() && (getUserRole() in ['admin', 'hod', 'teacher', 'accountant']);
    }

    // Prevents plaintext passwords, temporary passwords, or password hashes from ever being written to Firestore
    function hasNoSensitiveAuthFields(data) {
      return !(
        'password' in data ||
        'plainPassword' in data ||
        'plaintextPassword' in data ||
        'tempPassword' in data ||
        'temporaryPassword' in data ||
        'defaultPassword' in data ||
        'loginPassword' in data ||
        'admissionPassword' in data ||
        'staffPassword' in data ||
        'parentPassword' in data ||
        'studentPassword' in data ||
        'passwordHash' in data ||
        'salt' in data
      );
    }

    // ==========================================
    // 1. PRINTING REQUESTS (ISOLATED WORKFLOW)
    // ==========================================
    match /printingRequests/{orderId} {
      allow read: if isSignedIn() && (
        isOperations() ||
        isPrintingDept() ||
        resource.data.requesterId == request.auth.uid
      );

      allow create: if isSignedIn() && (isOperations() || isStaff());

      allow update: if isSignedIn() && (
        isOperations() ||
        isPrintingDept() ||
        (resource.data.requesterId == request.auth.uid && resource.data.status == 'pending')
      );

      allow delete: if isOperations() || (isSignedIn() && resource.data.requesterId == request.auth.uid && resource.data.status == 'pending');
    }

    // ==========================================
    // 2. LIBRARY COLLECTIONS
    // ==========================================
    match /libraryBooks/{bookId} {
      allow read: if isSignedIn() && !isPrintingDept();
      allow write: if isOperations();
    }

    match /libraryCopies/{copyId} {
      allow read: if isSignedIn() && !isPrintingDept();
      allow write: if isOperations();
    }

    match /libraryTransactions/{txId} {
      allow read: if isSignedIn() && !isPrintingDept() && (
        isOperations() ||
        isStaff() ||
        resource.data.memberId == request.auth.uid ||
        (getUserRole() == 'student' && (
          resource.data.memberId == getUserData().studentUid ||
          resource.data.memberId == getUserData().studentDocId ||
          resource.data.memberId == getUserData().id
        )) ||
        (getUserRole() == 'parent' && resource.data.memberId in getUserData().linkedStudentUids)
      );
      allow write: if isOperations();
    }

    match /librarySettings/{settingId} {
      allow read: if isSignedIn() && !isPrintingDept();
      allow write: if isOperations();
    }

    // ==========================================
    // 3. INVENTORY, UNIFORMS & TEXTBOOKS
    // ==========================================
    match /inventoryItems/{itemId} {
      allow read: if isSignedIn() && !isPrintingDept();
      allow write: if isOperations();
    }

    match /inventoryMovements/{movId} {
      allow read: if isSignedIn() && !isPrintingDept();
      allow create: if isOperations();
      allow update, delete: if false; // Immutable audit log
    }

    match /uniformItems/{uniformId} {
      allow read: if isSignedIn() && !isPrintingDept();
      allow write: if isOperations();
    }

    match /uniformIssues/{issueId} {
      allow read: if isSignedIn() && !isPrintingDept();
      allow write: if isOperations();
    }

    match /textbookItems/{textbookId} {
      allow read: if isSignedIn() && !isPrintingDept();
      allow write: if isOperations();
    }

    match /bookDistributions/{distId} {
      allow read: if isSignedIn() && !isPrintingDept();
      allow write: if isOperations();
    }

    // ==========================================
    // 4. CENTRAL AUDIT LOGS
    // ==========================================
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && hasNoSensitiveAuthFields(request.resource.data);
      allow update, delete: if false; // Immutable audit trail
    }

    // ==========================================
    // 5. EXISTING COLLECTIONS - ISOLATED FROM PRINTING & OPERATIONS
    // ==========================================
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin() || isStaff());
      allow create: if isAdmin() && hasNoSensitiveAuthFields(request.resource.data);
      allow update: if isAdmin() && hasNoSensitiveAuthFields(request.resource.data) && (
        // Prevent mutating immutable authUid link
        !('authUid' in request.resource.data) ||
        !('authUid' in resource.data) ||
        request.resource.data.authUid == resource.data.authUid
      );
      allow delete: if isAdmin();
    }

    match /students/{studentId} {
      // Operations needs read access to search student names for library circulation and uniform issues
      allow read: if isSignedIn() && !isPrintingDept();
      allow create: if (isAdmin() || (isSignedIn() && getUserRole() == 'hod')) && hasNoSensitiveAuthFields(request.resource.data);
      allow update: if (isAdmin() || (isSignedIn() && getUserRole() == 'hod')) && hasNoSensitiveAuthFields(request.resource.data);
      allow delete: if isAdmin();
    }

    match /teachers/{teacherId} {
      allow read: if isSignedIn() && !isPrintingDept() && getUserRole() != 'operations';
      allow create, update: if isAdmin() && hasNoSensitiveAuthFields(request.resource.data);
      allow delete: if isAdmin();
    }

    match /admissions/{admissionId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && hasNoSensitiveAuthFields(request.resource.data);
      allow delete: if isAdmin();
    }

    match /enrollments/{enrollmentId} {
      allow read: if isSignedIn() && !isPrintingDept() && getUserRole() != 'operations';
      allow write: if isAdmin() || (isSignedIn() && getUserRole() == 'hod');
    }

    match /masterFeeHeads/{headId} {
      allow read: if isSignedIn() && !isPrintingDept() && getUserRole() != 'operations';
      allow write: if isAdmin() || (isSignedIn() && getUserRole() == 'accountant');
    }

    match /studentFeeAssignments/{assignmentId} {
      allow read: if isSignedIn() && !isPrintingDept() && getUserRole() != 'operations' && (
        isAdmin() || 
        getUserRole() == 'accountant' ||
        (getUserRole() == 'student' && (
          resource.data.studentId == request.auth.uid ||
          resource.data.studentUid == request.auth.uid ||
          resource.data.authUid == request.auth.uid
        )) ||
        (getUserRole() == 'parent' && (
          resource.data.studentId in getUserData().linkedStudentUids ||
          resource.data.studentUid in getUserData().linkedStudentUids ||
          resource.data.authUid in getUserData().linkedStudentUids
        ))
      );
      allow create: if isAdmin() || (isSignedIn() && getUserRole() == 'accountant');
      allow update: if isAdmin() || (isSignedIn() && getUserRole() == 'accountant');
      allow delete: if isAdmin();
    }

    match /feeLedgerEntries/{entryId} {
      allow read: if isSignedIn() && !isPrintingDept() && getUserRole() != 'operations' && (
        isAdmin() || 
        getUserRole() == 'accountant' ||
        resource.data.studentId == request.auth.uid ||
        resource.data.studentUid == request.auth.uid ||
        resource.data.authUid == request.auth.uid ||
        (getUserRole() == 'parent' && (
          resource.data.studentId in getUserData().linkedStudentUids ||
          resource.data.studentUid in getUserData().linkedStudentUids ||
          resource.data.authUid in getUserData().linkedStudentUids
        ))
      );
      allow create: if isAdmin() || (isSignedIn() && getUserRole() == 'accountant');
      allow update, delete: if false;
    }

    match /feePayments/{paymentId} {
      allow read: if isSignedIn() && !isPrintingDept() && getUserRole() != 'operations' && (
        isAdmin() ||
        getUserRole() == 'accountant' ||
        resource.data.studentId == request.auth.uid ||
        resource.data.studentUid == request.auth.uid ||
        resource.data.authUid == request.auth.uid ||
        (getUserRole() == 'parent' && (
          resource.data.studentId in getUserData().linkedStudentUids ||
          resource.data.studentUid in getUserData().linkedStudentUids ||
          resource.data.authUid in getUserData().linkedStudentUids
        ))
      );
      allow create: if isAdmin() || (isSignedIn() && getUserRole() == 'accountant');
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /feeStructures/{feeId} {
      function isValidAcademicSession(data) {
        return !('academicSessionId' in data) ||
          (data.academicSessionId is string &&
           data.academicSessionId.size() > 0 &&
           data.academicSessionId.size() <= 100 &&
           exists(/databases/$(database)/documents/academicSessions/$(data.academicSessionId)));
      }

      allow read: if isSignedIn() && !isPrintingDept() && getUserRole() != 'operations';
      allow create, update: if (isAdmin() || (isSignedIn() && getUserRole() == 'accountant')) &&
        isValidAcademicSession(request.resource.data);
      allow delete: if isAdmin() || (isSignedIn() && getUserRole() == 'accountant');
    }

    match /academicSessions/{sessionId} {
      allow read: if isSignedIn() && !isPrintingDept() && getUserRole() != 'operations';
      allow write: if isAdmin();
    }

    match /examSchedules/{scheduleId} {
      allow read: if isSignedIn() && !isPrintingDept() && getUserRole() != 'operations';
      allow write: if isAdmin() || (isSignedIn() && getUserRole() == 'hod');
    }

    match /notices/{noticeId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || (isSignedIn() && getUserRole() == 'hod');
    }

    match /sections/{sectionId} {
      allow read: if isSignedIn() && !isPrintingDept() && getUserRole() != 'operations';
      allow write: if isAdmin() || (isSignedIn() && getUserRole() == 'hod');
    }

    match /subjects/{subjectId} {
      allow read: if isSignedIn() && !isPrintingDept() && getUserRole() != 'operations';
      allow write: if isAdmin();
    }

    match /subjectAssignments/{assignmentId} {
      allow read: if isSignedIn() && !isPrintingDept();
      allow write: if isAdmin() || (isSignedIn() && getUserRole() == 'hod');
    }

    // ==========================================
    // E-SIGNATURES & DOCUMENT SIGNATORIES
    // ==========================================
    match /signatures/{sigId} {
      // AUTHORIZED SIGNATORIES: Admin (Principal), HOD, Class Teacher ONLY.
      // Subject teachers, students, parents, accounts, printing, and operations
      // must never read or write signature records.
      allow read: if isSignedIn() && (isAdmin() || getUserRole() in ['hod', 'class_teacher']);
      // Admin can manage any signature record.
      // HOD and class_teacher can only write their own signature document (sigId == their Auth UID).
      allow create, update: if isAdmin() ||
        (isSignedIn() && getUserRole() == 'hod' && request.auth.uid == sigId) ||
        (isSignedIn() && getUserRole() == 'class_teacher' && request.auth.uid == sigId);
      // Delete is reserved for Admin only.
      allow delete: if isAdmin();
    }

    match /signatureConfigs/{configId} {
      // Configuration is readable by admin, hod, and class_teacher for document generation.
      allow read: if isSignedIn() && (isAdmin() || getUserRole() in ['hod', 'class_teacher']);
      // Only Admin can configure document signatory slots.
      allow write: if isAdmin();
    }

    // ==========================================
    // 6. ACADEMIC STRUCTURE PLANNER & RESULTS ENGINE
    // ==========================================
    match /academicStructures/{structureId} {
      allow read: if isSignedIn() && !isPrintingDept() && getUserRole() != 'operations';
      allow write: if isAdmin();
    }

    match /academicStructureVersions/{versionId} {
      allow read: if isSignedIn() && !isPrintingDept() && getUserRole() != 'operations';
      allow write: if isAdmin();
    }

    match /marksEntries/{entryId} {
      allow read: if isSignedIn() && !isPrintingDept() && getUserRole() != 'operations' && (
        isAdmin() ||
        getUserRole() in ['hod', 'teacher']
      );
      // Teachers and HODs can create and update marks only if the record is not locked.
      // Admin retains override unlock capability.
      allow create: if isSignedIn() && (isAdmin() || getUserRole() in ['hod', 'teacher']);
      allow update: if isSignedIn() && (
        isAdmin() ||
        (getUserRole() in ['hod', 'teacher'] && resource.data.workflowStatus != 'locked')
      );
      allow delete: if isAdmin();
    }

    match /publishedReportCards/{reportCardId} {
      allow read: if isSignedIn() && !isPrintingDept() && getUserRole() != 'operations' && (
        isAdmin() ||
        getUserRole() in ['hod', 'teacher'] ||
        (getUserRole() == 'student' && (
          resource.data.studentUid == getUserData().studentUid ||
          resource.data.studentId == request.auth.uid ||
          resource.data.studentDocId == request.auth.uid
        )) ||
        (getUserRole() == 'parent' && (
          resource.data.studentUid in getUserData().linkedStudentUids ||
          resource.data.studentId in getUserData().linkedStudentUids
        ))
      );
      allow write: if isAdmin() || (isSignedIn() && getUserRole() == 'hod');
    }

    // ==========================================
    // 7. EVENTS & SCHOOL CALENDAR
    // ==========================================
    match /eventTypes/{typeId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if isSignedIn() && !isPrintingDept();
      allow write: if isAdmin();
    }

    match /notifications/{notifId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.recipientTeacherId == request.auth.uid ||
        (resource.data.recipientTeacherId != null && getUserRole() == 'teacher') ||
        resource.data.audienceType == 'all' ||
        (resource.data.audienceType == 'teachers' && getUserRole() in ['teacher', 'hod']) ||
        (resource.data.audienceType == 'students' && getUserRole() == 'student') ||
        (resource.data.audienceType == 'parents' && getUserRole() == 'parent') ||
        isAdmin()
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.recipientTeacherId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // ==========================================
    // 8. HALL TICKETS & FEE-BASED EXAM ELIGIBILITY
    // ==========================================
    match /hallTicketSettings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /hallTicketRules/{ruleId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /hallTicketBypasses/{bypassId} {
      allow read: if isSignedIn() && !isPrintingDept() && (
        isAdmin() ||
        getUserRole() in ['hod', 'teacher', 'accountant'] ||
        (getUserRole() == 'student' && (
          resource.data.studentId == request.auth.uid ||
          resource.data.studentUid == request.auth.uid
        )) ||
        (getUserRole() == 'parent' && resource.data.studentId in getUserData().linkedStudentUids)
      );
      allow create: if isSignedIn() && (
        isAdmin() ||
        getUserRole() == 'accountant' ||
        (
          getUserRole() == 'student' &&
          request.resource.data.status == 'pending' &&
          request.resource.data.requestedBy.uid == request.auth.uid &&
          (
            request.resource.data.studentUid == request.auth.uid ||
            request.resource.data.studentId == request.auth.uid
          )
        )
      );
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /hallTickets/{ticketId} {
      allow read: if isSignedIn() && !isPrintingDept() && (
        isAdmin() ||
        getUserRole() in ['hod', 'teacher', 'accountant'] ||
        (getUserRole() == 'student' && (
          resource.data.studentId == request.auth.uid ||
          resource.data.studentUid == request.auth.uid ||
          resource.data.studentDocId == request.auth.uid
        )) ||
        (getUserRole() == 'parent' && (
          resource.data.studentId in getUserData().linkedStudentUids ||
          resource.data.studentUid in getUserData().linkedStudentUids
        ))
      );
      allow write: if isAdmin();
    }

    match /paymentIntents/{intentId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        getUserRole() == 'accountant' ||
        resource.data.studentId == request.auth.uid ||
        resource.data.studentUid == request.auth.uid ||
        resource.data.createdBy == request.auth.uid
      );
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ==========================================
    // 9. PROFILE CHANGE REQUESTS (IDOR PROTECTED)
    // ==========================================
    match /profileChangeRequests/{requestId} {
      // User can read own change requests; Admin can read all
      allow read: if isSignedIn() && (
        isAdmin() ||
        resource.data.userId == request.auth.uid
      );

      // User can only create requests for themselves (IDOR protected)
      allow create: if isSignedIn() && (
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending'
      );

      // User can cancel their own pending request; Admin can approve/reject
      allow update: if isSignedIn() && (
        isAdmin() ||
        (
          resource.data.userId == request.auth.uid &&
          resource.data.status == 'pending' &&
          request.resource.data.status == 'cancelled' &&
          request.resource.data.userId == resource.data.userId
        )
      );

      allow delete: if false; // Immutable audit trail
    }
  }
}


