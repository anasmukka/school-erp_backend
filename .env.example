# Prestige International School ERP - Frontend Environment Configuration
# Copy this file to .env and configure with your Firebase project credentials

# Firebase Web App Configuration (Registered for project: prestige-erp / prestigeERP)
VITE_API_KEY=your_firebase_api_key
VITE_AUTH_DOMAIN=prestige-erp.firebaseapp.com
VITE_PROJECT_ID=prestige-erp
VITE_STORAGE_BUCKET=prestige-erp.firebasestorage.app
VITE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_APP_ID=your_app_id

# Backend URL (FastAPI backend service)
# In local development: http://localhost:8000
# In production: https://your-backend.onrender.com
VITE_BACKEND_URL=

# Cloudflare Worker Edge Gateway Endpoint (R2 Object Storage & Edge API)
# In local development: http://localhost:8787
# In production: https://<your-worker-subdomain>.workers.dev or https://api.yourdomain.com
VITE_WORKER_URL=

# Razorpay Payment Gateway (Public Key ID only - private secrets reside exclusively on Worker)
VITE_RAZORPAY_KEY_ID=
