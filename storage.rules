rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Printing order file attachments
    match /printing-orders/{fileName} {
      // Authenticated users (teachers, HODs, printing, admin) can read attachments
      allow read: if request.auth != null;
      // Staff and Admin can upload attachments up to 30MB
      allow write: if request.auth != null && request.resource.size < 30 * 1024 * 1024;
    }

    // Student and Staff photos & avatars (Max 5MB images)
    match /photos/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }

    // Official School Signatures & Seals (Max 2MB images)
    // Only Admin or the owner whose UID prefixes the fileName can write signatures
    match /signatures/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && 
        (request.auth.token.role == 'admin' || fileName.matches(request.auth.uid + '.*')) &&
        request.resource.size < 2 * 1024 * 1024 && 
        request.resource.contentType.matches('image/.*');
    }

    // Profile change request supporting documents (Max 10MB)
    match /profile-change-requests/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.size < 10 * 1024 * 1024;
    }

    // Default rules for other school media (Max 15MB) - Restricted to Admin write to prevent arbitrary file uploads
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.role == 'admin' && request.resource.size < 15 * 1024 * 1024;
    }
  }
}
